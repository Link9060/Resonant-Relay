# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-only, NEVER exposed to the browser or prefixed
# with NEXT_PUBLIC_. Used exclusively by src/lib/supabase/service.ts to read
# and write Google OAuth tokens, which are deliberately locked out of RLS
# (see supabase/migrations/0004_student_hub.sql).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by server-side code for the auth callback redirect
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The SAME Google OAuth Web application client configured in Supabase's
# Google provider settings. Needed separately here because Calendar/Gmail
# access-token refreshes are made directly against Google's token endpoint
# (https://oauth2.googleapis.com/token), not through Supabase.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# Web Push (real OS-level notifications). Generate a pair once with:
#   npx web-push generate-vapid-keys
# The public key is safe to expose to the browser (that's how Web Push
# works); the private key must stay server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# Shared secret checked by /api/cron/plan-reminders so only your scheduler
# (see vercel.json) can trigger it, not the open internet.
CRON_SECRET=a-long-random-string
